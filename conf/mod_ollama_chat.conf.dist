[worldserver]

########################################
# mod-ollama-chat configuration
########################################

# --------------------------------------------
# CORE MODULE TOGGLES & DEBUGGING
# --------------------------------------------

# OllamaChat.Enable
#     Description: Enable or disable the module.
#     Default:     1 (true)
OllamaChat.Enable = 1

# OllamaChat.DebugEnabled
#     Description: Enables extra logging for debugging purposes.
#                  When set to 1 (true), detailed debug information will be logged by the module.
#                  When set to 0 (false), only standard logging is used.
#     Default:     0 (false)
OllamaChat.DebugEnabled = 0

# --------------------------------------------
# BRIDGE CONNECTION
# --------------------------------------------

# OllamaChat.Bridge.Instance / Endpoint / Token
#     Description: The bridge is the module's only generation path (provider claude).
#                  An enabled module without valid bridge settings is idle: it logs one
#                  line at config load, listens on no port, starts no workers and
#                  generates nothing. Instance identifies this game instance.
#                  Instance starts with an ASCII letter or digit and uses
#                  1-128 ASCII letters, digits, dot, colon, underscore or hyphen. Endpoint
#                  must be http://127.0.0.1 with an optional port in 1-65535, and no path,
#                  query, credentials or trailing slash.
#                  The module posts to /v1/generate.
#
#                  Provision the same independent local bearer at both ends explicitly,
#                  with at least 128 random bits encoded as base64url or hex (22-512
#                  characters). TokenRef in selection JSON is only a reference: never
#                  put the bearer there or reuse native subscription/API credentials.
#                  Restrict local config file access as for the database password.
#                  No token, request body or remote error body is logged by this path.
#
#                  Reload publishes settings; it does not activate a bridge or acknowledge
#                  CLI selection. The trusted game owner must retire old work and provide
#                  a fresh epoch before generation can run. Queued requests keep their
#                  captured settings/identity/deadline. World delivery rechecks authority.
#                  This path has no automatic provider switch, retry or LLM fallback.
#     Default:     all empty (the module idles)
OllamaChat.Bridge.Instance =
OllamaChat.Bridge.Endpoint =
OllamaChat.Bridge.Token =

# OllamaChat.Bridge.ChannelEnabled
#     Description: Opt in to the provider-neutral reverse mailbox for a selected game bridge epoch.
#                  I/O adapters authenticate every receive/result operation with Bridge.Token; they
#                  must bound loopback sockets/bytes and retain returned packets through actual writes.
#                  Up to 64 physical packets and 8 world-thread dequeues per tick. Reload revokes old
#                  work immediately; a replacement epoch waits for actual payload disposal and drain.
#                  The shared runtime installs filtered queries and current-mark event production.
#                  While on, the module listens on 127.0.0.1:ChannelPort for the bridge (J5d, below);
#                  typed commands are answered by the world thread (J6).
#                  Live delivery awaits J9C/X proof.
#                  No raw commands, inference fallback, or model text execution is permitted.
#     Default:     0 (existing generation behavior; reverse mailbox unavailable)
OllamaChat.Bridge.ChannelEnabled = 0

# OllamaChat.Bridge.ChannelPort
#     Description: TCP port of the bridge channel listener (J5d). While ChannelEnabled is on and the
#                  Bridge settings above are valid, the module listens on literal 127.0.0.1 only (never
#                  another address). The local bridge posts one query or command envelope to
#                  POST /v1/channel/{route} with "Authorization: Bearer <Bridge.Token>" and gets the
#                  world thread's filtered result in the reply (wire: hub bridge/game/README.md).
#                  Other peers, wrong tokens and bodies over 65536 bytes are refused before the body
#                  is read; nothing from a request is logged. Valid ports are 1024-65535; another value
#                  logs one warning and leaves the listener closed. On Windows SO_REUSEADDR lets a second
#                  worldserver bind the same port silently, so give each instance with the channel
#                  enabled its own ChannelPort. A reload restarts it only when the port or the token
#                  changed. Give the bridge the same port.
#     Default:     18732
OllamaChat.Bridge.ChannelPort = 18732

# OllamaChat.Bridge.PersonaCardsEnabled
#     Description: Use durable persona cards in the native bridge for eligible bot/controller pairs.
#                  Requires Playerbots.Acquaintance.Enable and the Characters update
#                  data/sql/characters/updates/2026_11_06_persona_cards.sql.
#                  Stores up to 256 bot states in memory, with 16 pending operations and
#                  up to 8 completions processed per world update. Failed lookups retry
#                  on a qualified encounter after 30 seconds. Uses existing voice when unavailable.
#                  Storage opens at server startup: turning this on by reload leaves it
#                  unavailable until the next restart.
#                  Requires a bridge that accepts input.personaCard (J13C/X): the Claude
#                  bridge currently rejects it, so eligible direct replies would fail.
#     Default:     0 (false)
OllamaChat.Bridge.PersonaCardsEnabled = 0

# --------------------------------------------
# GENERAL CHATTER / RESPONSE LOGIC
# --------------------------------------------

# OllamaChat.PlayerReplyChance.Say
#     Description: The percent chance (0-100) that an eligible bot replies to a player in Say/Yell channels.
#     Default:     90
OllamaChat.PlayerReplyChance.Say = 90

# OllamaChat.BotReplyChance.Say
#     Description: The percent chance (0-100) that an eligible bot replies to another bot in Say/Yell channels.
#     Default:     10
OllamaChat.BotReplyChance.Say = 10

# OllamaChat.PlayerReplyChance.Channel
#     Description: The percent chance (0-100) that an eligible bot replies to a player in custom channels (General, Trade, etc.).
#     Default:     60
OllamaChat.PlayerReplyChance.Channel = 60

# OllamaChat.BotReplyChance.Channel
#     Description: The percent chance (0-100) that an eligible bot replies to another bot in custom channels (General, Trade, etc.).
#     Default:     3
OllamaChat.BotReplyChance.Channel = 3

# OllamaChat.PlayerReplyChance.Party
#     Description: The percent chance (0-100) that an eligible bot replies to a player in Party/Raid chat.
#     Default:     90
OllamaChat.PlayerReplyChance.Party = 90

# OllamaChat.BotReplyChance.Party
#     Description: The percent chance (0-100) that an eligible bot replies to another bot in Party/Raid chat.
#     Default:     25
OllamaChat.BotReplyChance.Party = 25

# OllamaChat.PlayerReplyChance.Guild
#     Description: The percent chance (0-100) that an eligible bot replies to a player in Guild/Officer chat.
#     Default:     70
OllamaChat.PlayerReplyChance.Guild = 70

# OllamaChat.BotReplyChance.Guild
#     Description: The percent chance (0-100) that an eligible bot replies to another bot in Guild/Officer chat.
#     Default:     5
OllamaChat.BotReplyChance.Guild = 5

# OllamaChat.EnableWhisperReplies
#     Description: Enable or disable bot responses to whisper messages.
#                  When set to 0 (false), bots will not reply to any whispers.
#                  When set to 1 (true), bots will reply to whispers based on normal reply chances.
#     Default:     0 (false)
#
#        A whisper is direct address, so when this is on the bot ALWAYS
#        answers. It is not subject to PlayerReplyChance.* (it used to borrow
#        PlayerReplyChance.Say, so lowering that randomly swallowed whispers
#        and setting it to 0 silenced them entirely), and it is not held back
#        by BotCooldownSeconds, ScopeCooldownSeconds, ScopeMessagesPerMinute or
#        the repetition filter -- those pace ambient chatter and have no
#        business silencing an answer to a direct question.
#
#        GlobalMessagesPerMinute still applies: that one protects the LLM
#        backend rather than pacing the bots.
OllamaChat.EnableWhisperReplies = 0

# OllamaChat.MaxBotsToPick
#     Description: The maximum number of bots that can be randomly selected to reply when no bot name is explicitly mentioned.
#     Default:     2
OllamaChat.MaxBotsToPick = 2

# OllamaChat.SayDistance
#     Description: The maximum distance (in game units) a bot must be within to reply on a Say message.
#     Default:     30.0
OllamaChat.SayDistance = 30.0

# OllamaChat.YellDistance
#     Description: The maximum distance (in game units) a bot must be within to reply on a Yell message.
#     Default:     100.0
OllamaChat.YellDistance = 100.0

# OllamaChat.DisableForCustomChannels
#     Description: When enabled (1), disables bot replies in custom channels (General, Trade, LookingForGroup, etc.).
#                  This allows you to reduce spam in public channels while keeping bot interactions in other chat types.
#     Default:     0 (false)
OllamaChat.DisableForCustomChannels = 0

# OllamaChat.DisableForSayYell
#     Description: When enabled (1), disables bot replies in Say and Yell channels.
#                  Useful if you want bots to be silent in proximity-based chats.
#     Default:     0 (false)
OllamaChat.DisableForSayYell = 0

# OllamaChat.DisableForGuild
#     Description: When enabled (1), disables bot replies in Guild and Officer channels.
#                  Useful for keeping guild chat focused without bot chatter.
#     Default:     0 (false)
OllamaChat.DisableForGuild = 0

# OllamaChat.DisableForParty
#     Description: When enabled (1), disables bot replies in Party and Raid channels.
#                  Useful if you want party chat to be bot-free.
#     Default:     0 (false)
OllamaChat.DisableForParty = 0

# OllamaChat.DisableRepliesInCombat
#     Description: If true, bots will not reply when in combat.
#     Default:     1
OllamaChat.DisableRepliesInCombat = 1

# --------------------------------------------
# TYPING SIMULATION
# --------------------------------------------

# OllamaChat.EnableTypingSimulation
#     Description: When enabled (1), bots will delay their responses proportionally to the message length
#                  to simulate realistic typing behavior. The delay is calculated as:
#                  BaseDelay + (MessageLength * DelayPerChar) milliseconds
#                  Example: 100 character message with defaults = 1000ms + (100 * 250ms) = 26 seconds
#     Default:     0 (false)
OllamaChat.EnableTypingSimulation = 0

# OllamaChat.TypingSimulationBaseDelay
#     Description: Base delay in milliseconds before a bot starts "typing" a response.
#                  This simulates the time it takes to read the message and start typing.
#     Default:     1000
OllamaChat.TypingSimulationBaseDelay = 1000

# OllamaChat.TypingSimulationDelayPerChar
#     Description: Additional delay in milliseconds per character in the bot's response.
#                  Realistic typing speeds:
#                  - 400ms per char = 2.5 chars/sec (slow/casual)
#                  - 250ms per char = 4 chars/sec (average human)
#                  - 150ms per char = 6.7 chars/sec (proficient)
#                  - 100ms per char = 10 chars/sec (professional)
#     Default:     250
OllamaChat.TypingSimulationDelayPerChar = 250

###############################################################################
#
#   OLLAMA CHAT - DISPATCHER AND HTTP
#
###############################################################################

#    OllamaChat.WorkerThreads
#        Size of the pool that performs bridge calls. Workers do HTTP and
#        string work only; every reply is delivered on the world thread.
#        Default: 4
OllamaChat.WorkerThreads = 4

#    OllamaChat.MaxQueueDepth
#        Requests waiting for a worker. Beyond this, new requests are dropped
#        rather than queued, so a slow bridge sheds load instead of building an
#        ever-growing backlog of stale replies. 0 = unlimited (not advised).
#        Default: 64
OllamaChat.MaxQueueDepth = 64

#    OllamaChat.TypingSimulationMaxDelay
#        Ceiling on the simulated typing delay, in milliseconds. Without a cap
#        a long reply could be held back for a very long time.
#        Default: 8000
OllamaChat.TypingSimulationMaxDelay = 8000

###############################################################################
#
#   OLLAMA CHAT - RESPONSE CLEANUP
#
###############################################################################

#    OllamaChat.MaxReplyLength
#        Maximum reply length in bytes. WoW chat is limited to 255; the reply
#        is cut at the last sentence end if one is near, otherwise at a word
#        boundary, never mid-word and never mid-UTF-8-sequence.
#        Default: 240
OllamaChat.MaxReplyLength = 240

#    OllamaChat.StripMarkdown
#        Remove markdown emphasis, bullets, headings and code fences from
#        replies. Models emit these regardless of what the prompt asks for.
#        Default: 1
OllamaChat.StripMarkdown = 1

#    OllamaChat.StripDecorativeUnicode
#        Fold smart quotes and dashes to ASCII, then drop emoji and symbols the
#        3.3.5 client renders as boxes. Accented Latin characters are kept.
#        Default: 1
OllamaChat.StripDecorativeUnicode = 1

###############################################################################
#
#   OLLAMA CHAT - CONVERSATION GOVERNOR
#
#   Four independent brakes, because bot chat runs away in four different ways.
#   If bots are talking endlessly among themselves, these are the settings to
#   reach for -- in particular RequireRecentHuman, which does most of the work.
#
###############################################################################

#    OllamaChat.BotConversation.MaxChainDepth
#        How many bot-replies-to-bot hops a conversation may run before it is
#        cut. A message from a real player is depth 0.
#        Default: 3
OllamaChat.BotConversation.MaxChainDepth = 3

#    OllamaChat.BotConversation.ChanceDecayPct
#        Reply chance multiplier applied at each hop, as a percentage. At 50, a
#        20% base chance becomes 10% at depth 1 and 5% at depth 2, so chains
#        run out of energy on their own well before the hard ceiling.
#        Default: 50
OllamaChat.BotConversation.ChanceDecayPct = 50

#    OllamaChat.BotConversation.RequireRecentHuman
#        Bots may only reply to OTHER BOTS while a real player has spoken in
#        that same channel recently. Two bots alone in a guild at 4am fall
#        silent; the same two bots talking around a player keep going.
#        Default: 1
OllamaChat.BotConversation.RequireRecentHuman = 1

#    OllamaChat.BotConversation.HumanWindowSeconds
#        How long a real player's message keeps bot-to-bot chat alive.
#        Default: 120
OllamaChat.BotConversation.HumanWindowSeconds = 120

#    OllamaChat.Cooldown.PerBotSeconds
#        Minimum gap between two lines from the same bot. This paces ambient
#        chatter and is deliberately skipped for direct address -- see
#        OllamaChat.Cooldown.DirectAddressGroupSize below.
#        Default: 45
OllamaChat.Cooldown.PerBotSeconds = 45

#    OllamaChat.Cooldown.PerScopeSeconds
#        Minimum gap between any two bot lines in the same channel.
#        Default: 15
OllamaChat.Cooldown.PerScopeSeconds = 15

#    OllamaChat.Cooldown.DirectAddressGroupSize
#        Party and raid chat from a real player counts as "direct address" when
#        the group has this many members or fewer, which exempts the reply from
#        the two pacing cooldowns above.
#
#        Those cooldowns exist to stop ambient chatter running hot. In a party
#        they did the wrong thing: a bot answered the first thing said to it and
#        then ignored the next 45 seconds of conversation, which looks like the
#        bot is broken rather than like rate limiting working. A five-person
#        party is a conversation; a 25-man raid is a crowd, so above this size
#        pacing comes back.
#
#        Whispers and messages that name the bot are always direct address,
#        whatever this is set to. Set to 0 to disable the group case and pace
#        party chat like any other channel.
#
#        The global RateLimit.GlobalPerMinute ceiling still applies to direct
#        address; that one protects the LLM backend, not the pacing.
#        Default: 5
OllamaChat.Cooldown.DirectAddressGroupSize = 5

#    OllamaChat.Cooldown.ConversationWindowSeconds
#        How long a bot stays "in conversation" with someone after answering
#        them, per channel. While that window is open, everything that person
#        says in that channel counts as direct address for that bot: it skips
#        the pacing cooldowns and replies at DirectAddressReplyChance.
#
#        This is what keeps a conversation going. Without it a bot answers the
#        first line, and then the follow-ups -- which usually do not repeat the
#        bot name -- fall back to ambient pacing and it goes quiet again.
#
#        Only ever opened against a real player, never bot-to-bot; that would
#        let two bots talk each other past every brake in the governor.
#        Set to 0 to require a name mention on every single line.
#        Default: 180
OllamaChat.Cooldown.ConversationWindowSeconds = 180

#    OllamaChat.DirectAddressReplyChance
#        Reply chance used instead of the per-channel PlayerReplyChance when the
#        line is aimed at this bot -- whispered, naming it, mid-conversation, or
#        in a small party. Someone who has been talking to you does not go 50/50
#        on whether to acknowledge your next sentence.
#
#        Never lowers a channel chance that is already higher. Set to 0 to turn
#        the boost off and use the ambient per-channel chance everywhere; note
#        that 0 also restores the old behaviour where a channel set to 0%
#        ignores a bot being addressed by name.
#        Default: 95
OllamaChat.DirectAddressReplyChance = 95

#    OllamaChat.RateLimit.ScopePerMinute
#        Ceiling on bot messages per channel per minute. 0 = unlimited.
#        Default: 8
OllamaChat.RateLimit.ScopePerMinute = 8

#    OllamaChat.RateLimit.GlobalPerMinute
#        Server-wide ceiling on bot messages per minute. Also caps your LLM
#        spend. 0 = unlimited.
#        Default: 40
OllamaChat.RateLimit.GlobalPerMinute = 40

#    OllamaChat.Repetition.BotHistorySize
#        How many of its own recent lines each bot remembers for comparison.
#        Default: 12
OllamaChat.Repetition.BotHistorySize = 12

#    OllamaChat.Repetition.ScopeHistorySize
#        How many recent lines each channel remembers, so two different bots do
#        not say the same thing.
#        Default: 30
OllamaChat.Repetition.ScopeHistorySize = 30

#    OllamaChat.Repetition.SimilarityThreshold
#        0.0 - 1.0. A candidate reply scoring at or above this against recent
#        history is discarded. Scoring is the higher of content-word Jaccard
#        and character-trigram cosine. Lower = stricter.
#        Default: 0.72
OllamaChat.Repetition.SimilarityThreshold = 0.72

#    OllamaChat.Repetition.WindowSeconds
#        How long remembered lines stay eligible for comparison.
#        Default: 1800
OllamaChat.Repetition.WindowSeconds = 1800

#    OllamaChat.Repetition.OpenerHistorySize
#        Recent opening phrases (first three words) blocked per channel. This
#        catches the "every bot starts with Aye," problem, which whole-line
#        similarity scoring misses.
#        Default: 8
OllamaChat.Repetition.OpenerHistorySize = 8

###############################################################################
#
#   OLLAMA CHAT - ROLEPLAY MODE
#
#   Race and class as a VOICE rather than as a stat line. Off by default.
#
###############################################################################

#    OllamaChat.Roleplay.Enable
#        Master switch for roleplay mode.
#        Default: 0
OllamaChat.Roleplay.Enable = 0

#    OllamaChat.Roleplay.Strictness
#        How strictly the bridge's voice instruction keeps a bot in character.
#        0 = Flavour only. Race and class voices colour the voice instruction;
#            nothing else changes.
#        1 = In character. Out-of-world vocabulary is filtered from replies and
#            the instruction forbids talk of servers, specs or numbers.
#        2 = As 1, and injuries, distances and dangers are to be described in
#            words, never as figures.
#        3 = In world. The instruction is worded without naming the things it
#            forbids (a small model tends to talk about whatever a prompt names).
#        Default: 1
OllamaChat.Roleplay.Strictness = 1

#    OllamaChat.Roleplay.UseRaceVoice
#        Give each race a speech register and cultural touchstones -- a Tauren
#        speaks of the Earthmother and the balance, a Forsaken is dry and calls
#        the living "breathers", a Gnome is fast and technical.
#        Default: 1
OllamaChat.Roleplay.UseRaceVoice = 1

#    OllamaChat.Roleplay.UseClassVoice
#        Give each class a worldview -- what that character NOTICES. A priest
#        sees wounds, a hunter reads tracks and terrain, a rogue counts exits.
#        Default: 1
OllamaChat.Roleplay.UseClassVoice = 1

#    OllamaChat.Roleplay.FactionAttitude
#        Bots speak as loyal to their own faction and wary of the other.
#        Default: 1
OllamaChat.Roleplay.FactionAttitude = 1

#    OllamaChat.Roleplay.BlockMetaTerms
#        At Strictness >= 1, reject any reply containing out-of-world
#        vocabulary. The line is dropped rather than mangled, so the bot stays
#        silent instead of stepping out of character.
#        Default: 1
OllamaChat.Roleplay.BlockMetaTerms = 1

#    OllamaChat.Roleplay.MetaTermList
#        Pipe-separated, matched as whole words, case-insensitive.
OllamaChat.Roleplay.MetaTermList = "dps|nerf|proc|patch|server|realm|respec|mmo|npc|toon|irl|lfg|afk|noob|meta|aggro|dot|hot|aoe|wipe|hitbox|hotfix|expansion"

#    OllamaChat.Roleplay.CrossFactionGibberish
#        Do not generate say/yell replies across factions. The client renders
#        Orcish and Common as gibberish anyway, so a fluent cross-faction reply
#        is the single most immersion-breaking thing the module can do --
#        and skipping it saves the bridge round trip too.
#        Default: 1
OllamaChat.Roleplay.CrossFactionGibberish = 1

###############################################################################
#
#   OLLAMA CHAT - EMBODIMENT (FACING, GESTURES, EMOTE REACTIONS)
#
#   Makes a reply read as conversation rather than as a log line.
#
###############################################################################

#    OllamaChat.EnableBotFacing
#        Turn the bot to face whoever it is answering, just before the line
#        lands. Skipped while the bot is moving, casting, in combat, mounted in
#        flight, on a transport, or being teleported.
#        Default: 1
OllamaChat.EnableBotFacing = 1

#    OllamaChat.Facing.MaxDistance
#        Do not turn toward a target further away than this. 0 = no limit.
#        Default: 40
OllamaChat.Facing.MaxDistance = 40

#    OllamaChat.EnableBotEmotes
#        Let bots play a real text emote alongside a reply when the reply
#        carries a gesture tag: "[emote:wave]", "*waves*" or a bare "/wave".
#        Unrecognised tags are stripped rather than spoken.
#
#        The emote is played through the same code path the client uses, so
#        nearby players see the animation AND the "Bot waves at You." social
#        text, with the correct per-race and per-gender emote variant.
#        Default: 1
OllamaChat.EnableBotEmotes = 1

#    OllamaChat.StateEmoteDurationMs
#        How long a bot holds a posture or looping emote, in milliseconds.
#
#        Two emotes stick, for two different reasons:
#
#          /dance          sets UNIT_NPC_EMOTESTATE. The only thing that clears
#                          it for a real player is the handler for a movement
#                          packet from the client, and bots move server-side
#                          through MotionMaster so they never send one. Without
#                          this a mirrored /dance danced forever, and even
#                          resumed after combat or a one-shot emote because the
#                          field was still set underneath.
#
#          /sit /sleep     the core's text-emote handler broadcasts the social
#          /kneel          line for these and then does nothing, so the bot
#                          announced it was sitting down while standing there.
#                          The module applies the posture the core leaves out,
#                          which means it also has to take it back off.
#
#        The bot is only stood back up when it is still in the exact posture
#        the emote put it in, so this never interrupts eating, drinking, or a
#        sit its own AI chose afterwards.
#
#        0 disables both the posture change and the clear.
#        Default: 15000
OllamaChat.StateEmoteDurationMs = 15000

#    OllamaChat.EmoteFallback
#        Gesture to play when the model supplies an emote name that is not a
#        real WoW emote. Models reach for ones the game does not have
#        ("grunt"), so those replies used to lose their gesture with nothing in
#        the log.
#
#        Set to a name from the emote table, or leave empty for no fallback.
#        Unresolved names are logged when DebugEnable is on, so you can see
#        which ones your model favours and decide whether to care.
#        Default: talk
OllamaChat.EmoteFallback = "talk"

#    OllamaChat.BotExpressionDelayMs
#        Delay before the turn and gesture fire, in milliseconds. A small delay
#        keeps it from looking instant and robotic.
#        Default: 400
OllamaChat.BotExpressionDelayMs = 400

#    OllamaChat.EnableEmoteReactions
#        Bots react when a real player emotes at them.
#        Default: 1
OllamaChat.EnableEmoteReactions = 1

#    OllamaChat.EmoteReplyChance
#        Percentage chance a bot reacts to an emote aimed at it.
#        Default: 60
OllamaChat.EmoteReplyChance = 60

#    OllamaChat.EmoteReply.MirrorWeight
#    OllamaChat.EmoteReply.CounterWeight
#        Relative weights for the two reaction styles:
#            Mirror  - wave gets a wave, bow gets a bow.
#            Counter - flex gets a laugh, rude gets a glare.
#        Defaults: 55 / 30
OllamaChat.EmoteReply.MirrorWeight = 55
OllamaChat.EmoteReply.CounterWeight = 30

#    OllamaChat.EmoteReply.CooldownSeconds
#        Debounce per (player, bot) pair, so /spam cannot flood the queue.
#        Default: 20
OllamaChat.EmoteReply.CooldownSeconds = 20
